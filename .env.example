# Copy to .env and adjust. Every value here is optional; defaults are shown.

# "ollama" (local, free), "anthropic" (hosted Claude API) or "gemini" (hosted Gemini API, has a free tier)
LLM_PROVIDER=ollama

# Local Ollama - also used for embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window for the local chat model; the source passages need more than Ollama's default
OLLAMA_NUM_CTX=16384

# Hosted Claude - required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Hosted Gemini - required when LLM_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Source discovery: set at least one so any topic can be researched from the web.
# Tavily is tried first, Brave Search is the fallback.
TAVILY_API_KEY=
BRAVE_API_KEY=
# Pages read per report across all research agents, and new pages each agent reads per round of searching
REPORT_MAX_SOURCES=30
SOURCES_PER_AGENT=5
# Source passages given to each agent (about 500 tokens each); use 10-12 for small local models
CONTEXT_CHUNKS=20
RESEARCH_MIN_SOURCES=2

CHROMA_PATH=./chroma_db
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LLM_TIMEOUT_SECONDS=120
