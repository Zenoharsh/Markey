# Copy to .env and adjust. Every value here is optional; defaults are shown.

# "ollama" (local, free) or "anthropic" (hosted Claude API)
LLM_PROVIDER=ollama

# Local Ollama - also used for embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Hosted Claude - required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Source discovery: set at least one so any topic can be researched from the web.
# Tavily is tried first, Brave Search is the fallback.
TAVILY_API_KEY=
BRAVE_API_KEY=
RESEARCH_MAX_SOURCES=8
RESEARCH_MIN_SOURCES=2

CHROMA_PATH=./chroma_db
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LLM_TIMEOUT_SECONDS=120
